[Unit]
Description=crypto-bot LIVE (Kraken 1h SOL/ETH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/crypto
# Where the binary keeps its state and reads .env, whichever checkout built it.
Environment=CRYPTO_BOT_ROOT=%h/github/crypto
EnvironmentFile=-%h/github/crypto/.env
ExecStart=%h/github/crypto/scripts/run-bot.sh live
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
